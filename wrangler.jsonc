{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "choice-arena-game",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "alias": {
    "firebase-admin/firestore": "./worker/firestore-rest.ts"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "choice-arena",
    "ALLOWED_ORIGINS": "https://choice-arena.web.app,https://choice-arena.firebaseapp.com,http://localhost:5173,http://127.0.0.1:5173"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
